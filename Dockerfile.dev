# syntax=docker/dockerfile:1

# ──────────────────────────────────────────────────────────────────────────────
# Development image — the production image (Dockerfile) is tiny and shell-less.
# This dev variant runs the binary on a debian-slim base so operators can `docker
# exec` into the container for interactive debugging (shell, curl, sqlite3).
# Use for devcontainers and ops boxes, never for production.
# Build:  docker build -f Dockerfile.dev -t nxt-opds:dev .
# ──────────────────────────────────────────────────────────────────────────────
FROM golang:1.24-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /nxt-opds .

FROM debian:bookworm-slim AS runtime

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl sqlite3 && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -u 1000 -m -d /app nxt-opds
USER nxt-opds

COPY --from=builder /nxt-opds /app/nxt-opds

VOLUME ["/data/books"]
WORKDIR /app
EXPOSE 8080

ENV LISTEN_ADDR=:8080
ENV BOOKS_DIR=/data/books
ENV BACKEND=sqlite

ENTRYPOINT ["/app/nxt-opds"]
